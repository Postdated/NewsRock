{
  "name": "postdated/newspack-bedrock",
  "description": "Newspack Bedrock — local-first newsroom publishing for Roots Bedrock WordPress",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Postdated",
      "homepage": "https://github.com/Postdated"
    },
    {
      "name": "Automattic",
      "homepage": "https://github.com/Automattic",
      "role": "Original Newspack plugins"
    },
    {
      "name": "Roots",
      "homepage": "https://roots.io",
      "role": "Bedrock WordPress boilerplate"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/wordpress": "^6.5",
    "roots/wp-config": "^1.0",
    "roots/wp-password-bcrypt": "^1.0",
    "oscarotero/env": "^2.1",
    "vlucas/phpdotenv": "^5.5",
    "wpackagist-plugin/wordpress-importer": "^0.8"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "roots/wordpress-core-installer": true,
      "composer/installers": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\""
    ],
    "test": [
      "phpcs"
    ]
  }
}
