{
  "name": "postdated/newspack-bedrock",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "description": "Newspack Bedrock v1.0.0 \u2014 local-first newsroom on Roots Bedrock + Acorn (Laravel)",
  "homepage": "https://github.com/Postdated/Newspack",
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/acorn": "^5.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^7.0",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "postdated/newsroom-speed-cache": "*@dev",
    "postdated/newspack-local-esps": "*@dev",
    "postdated/newsroom-image-downloader": "*@dev",
    "postdated/newpack-discord-bot-api": "*@dev"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^3.0",
    "roave/security-advisories": "dev-latest"
  },
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "type": "path",
      "url": "web/app/plugins/newsroom-speed-cache"
    },
    {
      "type": "path",
      "url": "web/app/plugins/newspack-local-esps"
    },
    {
      "type": "path",
      "url": "web/app/plugins/newsroom-image-downloader"
    },
    {
      "type": "path",
      "url": "web/app/plugins/newpack-discord-bot-api"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/${name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/${name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/${name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest"
  }
}
